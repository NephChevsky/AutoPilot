@using AutoPilot.Services
@using GitHub.Copilot
@using Microsoft.Extensions.Options
@implements IDisposable
@inject AgentChatSession Chat
@inject UsageLedger Ledger
@inject AgentCatalog Catalog
@inject IOptions<AutoPilotSettings> Settings

<div class="chat-layout">
<aside class="conversations">
    <div class="conversations-header">
        <strong>Conversations</strong>
        <button type="button" class="btn secondary" @onclick="ResetAsync" disabled="@(Chat.IsBusy || Chat.IsLoading)">New conversation</button>
    </div>
    @if (_listError is not null)
    {
        <div class="entry error">@_listError</div>
    }
    <ul class="conversation-list">
        @foreach (var conversation in _conversations)
        {
            <li>
                <button type="button" class="conversation @(conversation.SessionId == Chat.CurrentSessionId ? "active" : "")"
                        disabled="@(Chat.IsBusy || Chat.IsLoading)" @onclick="() => OpenAsync(conversation.SessionId)">
                    <span class="conversation-title">@(string.IsNullOrWhiteSpace(conversation.Summary) ? "Untitled conversation" : conversation.Summary)</span>
                    <small>@conversation.ModifiedTime.ToLocalTime().ToString("g")</small>
                    @if (Ledger.Get(conversation.SessionId) is { } saved)
                    {
                        <small class="conversation-cost">@FormatPremium(saved.PremiumRequests) premium requests · @FormatCredits(saved.AiCredits) AI credits</small>
                    }
                    else
                    {
                        <small class="conversation-cost">—</small>
                    }
                </button>
            </li>
        }
        @if (_conversations.Count == 0 && _listError is null)
        {
            <li class="conversation-empty">No previous conversations</li>
        }
    </ul>
</aside>

<div class="chatbot">
    <header class="chat-header">
        <div class="agents">
            @foreach (var agent in _agents)
            {
                <span class="agent-chip @(IsOrchestrator(agent) ? "orchestrator" : "")" title="@agent.Description">
                    <strong>@agent.DisplayName</strong>
                    @if (agent.Model is not null)
                    {
                        <small>@agent.Model</small>
                    }
                </span>
            }
        </div>
        <div class="cost-summary">
            @if (Chat.CurrentBranch is { } branch)
            {
                <div class="branch-name" title="Conversation branch">Branch: @branch</div>
            }
            <div>
                This session:
                @if (Chat.CurrentCost is { } sessionCost)
                {
                    @($"{FormatPremium(sessionCost.PremiumRequests)} premium requests · {FormatCredits(sessionCost.AiCredits)} AI credits")
                }
                else
                {
                    @("—")
                }
            </div>
            @{ var totals = Ledger.GetTotals(); }
            <div>All sessions: @FormatPremium(totals.PremiumRequests) premium requests · @FormatCredits(totals.AiCredits) AI credits (@totals.SessionCount sessions)</div>
        </div>
    </header>

    <div class="messages">
        <div class="messages-inner">
            @if (_loadError is not null)
            {
                <div class="entry error">@_loadError</div>
            }

            @foreach (var entry in Chat.GetEntries())
            {
                switch (entry.Kind)
                {
                    case ChatEntryKind.User:
                        <div class="entry user"><div class="bubble">@entry.Text</div></div>
                        break;
                    case ChatEntryKind.Assistant:
                        <div class="entry assistant @(entry.IsSubagent ? "subagent" : "")">
                            <div class="author">@entry.Author</div>
                            <div class="bubble markdown">@((MarkupString)MarkdownRenderer.ToHtml(entry.Text))</div>
                        </div>
                        break;
                    case ChatEntryKind.Tool:
                        <div class="entry tool @(entry.IsSubagent ? "subagent" : "")">
                            <span class="author">@entry.Author</span>
                            <code>@entry.Text</code>
                            <span class="status @StatusClass(entry)">@StatusText(entry)</span>
                        </div>
                        break;
                    case ChatEntryKind.Activity:
                        <div class="entry activity">@entry.Text</div>
                        break;
                    case ChatEntryKind.Error:
                        <div class="entry error">@entry.Text</div>
                        break;
                }
            }

            @if (Chat.IsLoading)
            {
                <div class="entry activity working">Loading conversation...</div>
            }

            @if (Chat.IsBusy && Chat.PendingQuestion is null)
            {
                <div class="entry activity working">Working...</div>
            }
        </div>
    </div>

    @if (Chat.PendingQuestion is { } question)
    {
        <div class="question">
            <div class="question-text markdown">@((MarkupString)MarkdownRenderer.ToHtml(question.Question))</div>
            @if (question.Choices is { Count: > 0 } choices)
            {
                <div class="choices">
                    @foreach (var choice in choices)
                    {
                        <button type="button" class="btn secondary" @onclick="() => Chat.AnswerAsync(choice, wasFreeform: false)">@choice</button>
                    }
                </div>
            }
            @if (question.AllowFreeform != false)
            {
                <form class="composer" @onsubmit="AnswerAsync">
                    <input @bind="_answer" @bind:event="oninput" placeholder="Your answer..." />
                    <button type="submit" class="btn" disabled="@string.IsNullOrWhiteSpace(_answer)">Answer</button>
                </form>
            }
        </div>
    }

    <form class="composer" @onsubmit="SendAsync">
        <input @bind="_draft" @bind:event="oninput" placeholder="Describe the feature to build..."         disabled="@(Chat.IsBusy || Chat.IsLoading)" />
        @if (Chat.IsBusy)
        {
            <button type="button" class="btn danger" @onclick="Chat.AbortAsync">Stop</button>
        }
        else
        {
                    <button type="submit" class="btn" disabled="@(Chat.IsLoading || string.IsNullOrWhiteSpace(_draft))">Send</button>
        }
    </form>
</div>
</div>

@code {
    private IReadOnlyList<AgentDefinition> _agents = [];
    private string? _loadError;
    private string? _listError;
    private IReadOnlyList<SessionMetadata> _conversations = [];
    private string? _listedSessionId;
    private bool _wasBusy;
    private bool _isDisposed;
    private int _refreshVersion;
    private CancellationTokenSource _disposed = new();
    private string _draft = "";
    private string _answer = "";

    protected override void OnInitialized()
    {
        try
        {
            _agents = Catalog.LoadAgents();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }

        Chat.Changed += OnChatChanged;
        Ledger.Changed += OnLedgerChanged;
        _listedSessionId = Chat.CurrentSessionId;
        _wasBusy = Chat.IsBusy;
        _ = RefreshConversationsAsync();
    }

    private async Task RefreshConversationsAsync()
    {
        if (_isDisposed)
        {
            return;
        }

        var version = ++_refreshVersion;
        try
        {
            var list = await Chat.ListConversationsAsync(_disposed.Token);
            if (_isDisposed || version != _refreshVersion)
            {
                return;
            }

            _conversations = list;
            _listError = null;
        }
        catch (OperationCanceledException) when (_isDisposed)
        {
            return;
        }
        catch (Exception ex)
        {
            if (_isDisposed || version != _refreshVersion)
            {
                return;
            }

            _listError = $"Failed to list conversations: {ex.Message}";
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenAsync(string sessionId)
    {
        _draft = "";
        _answer = "";
        await Chat.LoadConversationAsync(sessionId);
    }

    private async Task SendAsync()
    {
        var prompt = _draft;
        _draft = "";
        await Chat.SendAsync(prompt);
    }

    private async Task AnswerAsync()
    {
        var answer = _answer;
        _answer = "";
        await Chat.AnswerAsync(answer, wasFreeform: true);
    }

    private async Task ResetAsync()
    {
        _draft = "";
        _answer = "";
        await Chat.ResetAsync();
    }

    private bool IsOrchestrator(AgentDefinition agent) =>
        string.Equals(agent.Name, Settings.Value.OrchestratorAgent, StringComparison.OrdinalIgnoreCase);

    private static string StatusClass(ChatEntry entry) => entry.Succeeded switch
    {
        true => "ok",
        false => "failed",
        null => "running",
    };

    private static string StatusText(ChatEntry entry) => entry.Succeeded switch
    {
        true => "done",
        false => "failed",
        null => "running",
    };

    private Task OnChatChanged()
    {
        if (_isDisposed)
        {
            return Task.CompletedTask;
        }

        // Re-list when a conversation was created/opened or a run finished.
        var refresh = Chat.CurrentSessionId != _listedSessionId || (_wasBusy && !Chat.IsBusy);
        _listedSessionId = Chat.CurrentSessionId;
        _wasBusy = Chat.IsBusy;
        if (refresh)
        {
            _ = RefreshConversationsAsync();
        }

        return InvokeAsync(StateHasChanged);
    }

    private static string FormatPremium(double value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static string FormatCredits(double value) => value.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);

    private void OnLedgerChanged()
    {
        if (_isDisposed)
        {
            return;
        }

        try
        {
            _ = InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
        }
    }

    public void Dispose()
    {
        _isDisposed = true;
        Chat.Changed -= OnChatChanged;
        Ledger.Changed -= OnLedgerChanged;
        _disposed.Cancel();
        _disposed.Dispose();
    }
}
