@using AutoPilot.Services
@using GitHub.Copilot
@using Microsoft.Extensions.Options
@implements IDisposable
@inject AgentChatSession Chat
@inject UsageLedger Ledger
@inject AgentCatalog Catalog
@inject IOptions<AutoPilotSettings> Settings
@inject RepositoryCatalog Repositories
@inject TaskStore Tasks

<div class="chat-layout">
<aside class="conversations">
    <section class="tasks">
        <div class="conversations-header">
            <strong>Tasks</strong>
        </div>
        @if (_repositories.Count == 0)
        {
            <div class="conversation-empty">No repositories found</div>
        }
        else
        {
            var panelRepository = PanelRepository;
            IReadOnlyList<RepositoryTask> panelTasks = panelRepository is null ? [] : Tasks.GetForRepository(panelRepository.Path);
            var chatBlocked = Chat.IsBusy || Chat.IsLoading || Chat.IsMerging;
            <select class="repo-select task-repo" value="@panelRepository?.Path" @onchange="OnTaskRepositoryChanged">
                @foreach (var repo in _repositories)
                {
                    <option value="@repo.Path">@repo.Name</option>
                }
            </select>
            <div class="task-form">
                <input type="text" placeholder="Task title" @bind="_taskTitle" @bind:event="oninput" />
                <textarea rows="2" placeholder="Description (optional)" @bind="_taskDescription" @bind:event="oninput"></textarea>
                <button type="button" class="btn" @onclick="AddTaskAsync" disabled="@string.IsNullOrWhiteSpace(_taskTitle)">Add task</button>
            </div>
            @if (_taskError is not null)
            {
                <div class="entry error">@_taskError</div>
            }
            <ul class="task-list">
                @foreach (var task in panelTasks)
                {
                    var current = task;
                    <li class="task @(current.IsSent ? "sent" : "pending")">
                        @if (_editingTaskId == current.Id && !current.IsSent)
                        {
                            <input type="text" @bind="_editTitle" @bind:event="oninput" />
                            <textarea rows="2" @bind="_editDescription" @bind:event="oninput"></textarea>
                            <div class="task-actions">
                                <button type="button" class="btn" @onclick="() => SaveTaskAsync(current)" disabled="@string.IsNullOrWhiteSpace(_editTitle)">Save</button>
                                <button type="button" class="btn secondary" @onclick="CancelEditTask">Cancel</button>
                            </div>
                        }
                        else
                        {
                            <div class="task-title">
                                @if (current.IsSent)
                                {
                                    <span class="task-badge">Sent</span>
                                }
                                @if (current.IsAgentCreated)
                                {
                                    <span class="task-badge agent" title="@("Created by " + current.CreatedBy)">By agent</span>
                                }
                                @current.Title
                            </div>
                            @if (!string.IsNullOrWhiteSpace(current.Description))
                            {
                                <div class="task-description">@current.Description</div>
                            }
                            @if (current.IsSent)
                            {
                                <small>Sent @current.SentAt!.Value.ToLocalTime().ToString("g")</small>
                            }
                            else
                            {
                                <small>Created @current.CreatedAt.ToLocalTime().ToString("g")</small>
                            }
                            <div class="task-actions">
                                @if (current.IsSent)
                                {
                                    <button type="button" class="btn secondary" @onclick="() => OpenTaskConversationAsync(current)" disabled="@chatBlocked">Open conversation</button>
                                }
                                else
                                {
                                    <button type="button" class="btn" @onclick="() => SendTaskAsync(current)" disabled="@chatBlocked">Send</button>
                                    <button type="button" class="btn secondary" @onclick="() => StartEditTask(current)">Edit</button>
                                }
                                <button type="button" class="btn danger" @onclick="() => DeleteTaskAsync(current)">Delete</button>
                                @if (!string.IsNullOrEmpty(current.SourceSessionId))
                                {
                                    <button type="button" class="btn secondary" @onclick="() => OpenSourceConversationAsync(current)" disabled="@chatBlocked">Open requesting conversation</button>
                                }
                            </div>
                        }
                    </li>
                }
                @if (panelTasks.Count == 0)
                {
                    <li class="conversation-empty">No tasks</li>
                }
            </ul>
        }
    </section>
    <div class="conversations-header">
        <strong>Conversations</strong>
        <button type="button" class="btn secondary" @onclick="ResetAsync" disabled="@(Chat.IsBusy || Chat.IsLoading || Chat.IsMerging)">New conversation</button>
    </div>
    @if (_listError is not null)
    {
        <div class="entry error">@_listError</div>
    }
    <ul class="conversation-list">
        @foreach (var item in _conversations)
        {
            var conversation = item.Session;
            <li>
                <button type="button" class="conversation @(conversation.SessionId == Chat.CurrentSessionId ? "active" : "")"
                        disabled="@(Chat.IsBusy || Chat.IsLoading || Chat.IsMerging)" @onclick="() => OpenAsync(item)">
                    <span class="conversation-title">@(string.IsNullOrWhiteSpace(conversation.Summary) ? "Untitled conversation" : conversation.Summary)</span>
                    <small class="conversation-repo">@item.Repository.Name</small>
                    <small>@conversation.ModifiedTime.ToLocalTime().ToString("g")</small>
                    @if (Ledger.Get(conversation.SessionId) is { } saved)
                    {
                        <small class="conversation-cost">@FormatPremium(saved.PremiumRequests) premium requests · @FormatCredits(saved.AiCredits) AI credits</small>
                    }
                    else
                    {
                        <small class="conversation-cost">—</small>
                    }
                </button>
            </li>
        }
        @if (_conversations.Count == 0 && _listError is null)
        {
            <li class="conversation-empty">No previous conversations</li>
        }
    </ul>
</aside>

<div class="chatbot">
    <header class="chat-header">
        <div class="agents">
            @foreach (var agent in _agents)
            {
                <span class="agent-chip @(IsOrchestrator(agent) ? "orchestrator" : "")" title="@agent.Description">
                    <strong>@agent.DisplayName</strong>
                    @if (agent.Model is not null)
                    {
                        <small>@agent.Model</small>
                    }
                </span>
            }
        </div>
        <div class="cost-summary">
            @if (Chat.CurrentRepository is { } currentRepository)
            {
                <div class="repo-name" title="Conversation repository">Repository: @currentRepository.Name</div>
            }
            @if (Chat.CurrentBranch is { } branch)
            {
                <div class="branch-name" title="Conversation branch">Branch: @branch</div>
                <button type="button" class="btn secondary review-btn" @onclick="OpenDiffAsync" disabled="@(Chat.IsBusy || Chat.IsLoading || Chat.IsMerging)">Review changes</button>
            }
            <div>
                This session:
                @if (Chat.CurrentCost is { } sessionCost)
                {
                    @($"{FormatPremium(sessionCost.PremiumRequests)} premium requests · {FormatCredits(sessionCost.AiCredits)} AI credits")
                }
                else
                {
                    @("—")
                }
            </div>
            @{ var totals = Ledger.GetTotals(); }
            <div>All sessions: @FormatPremium(totals.PremiumRequests) premium requests · @FormatCredits(totals.AiCredits) AI credits (@totals.SessionCount sessions)</div>
        </div>
    </header>

    @if (_diffOpen)
    {
        <section class="diff-panel">
            <div class="diff-header">
                <div>
                    <strong>Changes on @(Chat.CurrentBranch ?? _diff?.Branch)</strong>
                    @if (_diff is { } header)
                    {
                        <small class="diff-base">base @ShortSha(header.BaseCommit)</small>
                        <span class="diff-totals">
                            <span class="diff-add">+@header.TotalAdditions</span>
                            <span class="diff-del">−@header.TotalDeletions</span>
                            · @header.Files.Count @(header.Files.Count == 1 ? "file" : "files")
                        </span>
                    }
                </div>
                <div class="diff-actions">
                    <button type="button" class="btn secondary" @onclick="RefreshDiffAsync" disabled="@(_diffLoading || Chat.IsBusy || Chat.IsLoading || Chat.IsMerging)">Refresh</button>
                    @if (Chat.CurrentBranch is not null)
                    {
                        <button type="button" class="btn" @onclick="AskMerge" disabled="@(_diffLoading || Chat.IsBusy || Chat.IsLoading || Chat.IsMerging)">Merge</button>
                    }
                    <button type="button" class="btn secondary" @onclick="CloseDiff" disabled="@Chat.IsMerging">Close</button>
                </div>
            </div>
            @if (_mergeConfirm && Chat.CurrentBranch is { } mergeBranch)
            {
                <div class="merge-confirm">
                    <span>Merge <strong>@mergeBranch</strong> of repository <strong>@Chat.CurrentRepository?.Name</strong> into the branch currently checked out in that repository, push that branch to <strong>@Settings.Value.GitRemote</strong>, and delete the conversation's worktree and local branch?</span>
                    <button type="button" class="btn" @onclick="ConfirmMergeAsync" disabled="@(Chat.IsBusy || Chat.IsLoading || Chat.IsMerging)">Confirm merge</button>
                    <button type="button" class="btn secondary" @onclick="CancelMerge" disabled="@Chat.IsMerging">Cancel</button>
                </div>
            }
            @if (Chat.IsMerging)
            {
                <div class="entry activity working">Merging...</div>
            }
            @if (_mergeError is not null)
            {
                <div class="entry error">@_mergeError</div>
            }
            <div class="diff-body">
                @if (_diffLoading)
                {
                    <div class="entry activity working">Loading diff...</div>
                }
                else if (_diffError is not null)
                {
                    <div class="entry error">@_diffError</div>
                }
                else if (_diff is { } diff)
                {
                    @if (diff.Files.Count == 0)
                    {
                        <div class="entry activity">No changes</div>
                    }
                    else
                    {
                        <ul class="diff-files">
                            @for (var i = 0; i < diff.Files.Count; i++)
                            {
                                var file = diff.Files[i];
                                <li>
                                    <a href="@($"#diff-file-{i}")">@DisplayPath(file)</a>
                                    <span class="diff-status @file.Status.ToString().ToLowerInvariant()">@file.Status</span>
                                    @if (file.IsBinary)
                                    {
                                        <small>binary</small>
                                    }
                                    else
                                    {
                                        <span class="diff-add">+@file.Additions</span>
                                        <span class="diff-del">−@file.Deletions</span>
                                    }
                                </li>
                            }
                        </ul>
                        @for (var i = 0; i < diff.Files.Count; i++)
                        {
                            var file = diff.Files[i];
                            <details class="diff-file" id="@($"diff-file-{i}")" open>
                                <summary>
                                    <span class="diff-path">@DisplayPath(file)</span>
                                    <span class="diff-status @file.Status.ToString().ToLowerInvariant()">@file.Status</span>
                                    @if (!file.IsBinary)
                                    {
                                        <span class="diff-add">+@file.Additions</span>
                                        <span class="diff-del">−@file.Deletions</span>
                                    }
                                </summary>
                                @if (file.IsBinary)
                                {
                                    <div class="diff-binary">Binary file changed</div>
                                }
                                else
                                {
                                    <div class="diff-code">
                                        @foreach (var line in file.Lines)
                                        {
                                            <div class="diff-line @LineClass(line.Kind)"><span class="diff-marker">@LineMarker(line.Kind)</span>@line.Text</div>
                                        }
                                    </div>
                                }
                            </details>
                        }
                    }

                    @if (diff.Truncated)
                    {
                        <div class="entry error">The diff is very large and was truncated; later changes are not shown.</div>
                    }
                }
            </div>
        </section>
    }
    else
    {
    <div class="messages">
        <div class="messages-inner">
            @if (_loadError is not null)
            {
                <div class="entry error">@_loadError</div>
            }

            @foreach (var entry in Chat.GetEntries())
            {
                switch (entry.Kind)
                {
                    case ChatEntryKind.User:
                        <div class="entry user"><div class="bubble">@entry.Text</div></div>
                        break;
                    case ChatEntryKind.Assistant:
                        <div class="entry assistant @(entry.IsSubagent ? "subagent" : "")">
                            <div class="author">@entry.Author</div>
                            <div class="bubble markdown">@((MarkupString)MarkdownRenderer.ToHtml(entry.Text))</div>
                        </div>
                        break;
                    case ChatEntryKind.Tool:
                        <div class="entry tool @(entry.IsSubagent ? "subagent" : "")">
                            <span class="author">@entry.Author</span>
                            <code>@entry.Text</code>
                            <span class="status @StatusClass(entry)">@StatusText(entry)</span>
                        </div>
                        break;
                    case ChatEntryKind.Activity:
                        <div class="entry activity">@entry.Text</div>
                        break;
                    case ChatEntryKind.Error:
                        <div class="entry error">@entry.Text</div>
                        break;
                }
            }

            @if (Chat.IsLoading)
            {
                <div class="entry activity working">Loading conversation...</div>
            }

            @if (Chat.IsBusy && Chat.PendingQuestion is null)
            {
                <div class="entry activity working">Working...</div>
            }
        </div>
    </div>
    }

    @if (Chat.PendingQuestion is { } question)
    {
        <div class="question">
            <div class="question-text markdown">@((MarkupString)MarkdownRenderer.ToHtml(question.Question))</div>
            @if (question.Choices is { Count: > 0 } choices)
            {
                <div class="choices">
                    @foreach (var choice in choices)
                    {
                        <button type="button" class="btn secondary" @onclick="() => Chat.AnswerAsync(choice, wasFreeform: false)">@choice</button>
                    }
                </div>
            }
            @if (question.AllowFreeform != false)
            {
                <form class="composer" @onsubmit="AnswerAsync">
                    <input @bind="_answer" @bind:event="oninput" placeholder="Your answer..." />
                    <button type="submit" class="btn" disabled="@string.IsNullOrWhiteSpace(_answer)">Answer</button>
                </form>
            }
        </div>
    }

    <form class="composer" @onsubmit="SendAsync">
        @if (Chat.CurrentSessionId is null && !Chat.IsBusy)
        {
            @if (_repositories.Count == 0)
            {
                <div class="repo-empty">No repositories found in @Settings.Value.ResolveWorkingDirectory()</div>
            }
            else
            {
                <select class="repo-select" aria-label="Repository" @onchange="OnRepositoryChanged" disabled="@(Chat.IsLoading || Chat.IsMerging)">
                    @if (Chat.SelectedRepository is null)
                    {
                        <option value="" selected>Select a repository...</option>
                    }
                    @foreach (var repository in _repositories)
                    {
                        <option value="@repository.Path" selected="@(repository.Path == Chat.SelectedRepository?.Path)">@repository.Name</option>
                    }
                </select>
            }
        }
        <input @bind="_draft" @bind:event="oninput" placeholder="Describe the feature to build..." disabled="@(Chat.IsBusy || Chat.IsLoading || Chat.IsMerging)" />
        @if (Chat.IsBusy)
        {
            <button type="button" class="btn danger" @onclick="Chat.AbortAsync">Stop</button>
        }
        else
        {
                    <button type="submit" class="btn" disabled="@(Chat.IsLoading || Chat.IsMerging || string.IsNullOrWhiteSpace(_draft) || (Chat.CurrentSessionId is null && Chat.SelectedRepository is null))">Send</button>
        }
    </form>
</div>
</div>

@code {
    private IReadOnlyList<AgentDefinition> _agents = [];
    private string? _loadError;
    private string? _listError;
    private IReadOnlyList<ConversationSummary> _conversations = [];
    private IReadOnlyList<RepositoryInfo> _repositories = [];
    private string? _listedSessionId;
    private bool _wasBusy;
    private bool _isDisposed;
    private int _refreshVersion;
    private CancellationTokenSource _disposed = new();
    private string _draft = "";
    private string _answer = "";
    private bool _diffOpen;
    private bool _diffLoading;
    private ConversationDiff? _diff;
    private string? _diffError;
    private string? _diffSessionId;
    private int _diffVersion;
    private bool _mergeConfirm;
    private string? _mergeError;

    // Tasks panel state (its repository selection is separate from the new-conversation one).
    private string? _taskRepoPath;
    private string _taskTitle = "";
    private string _taskDescription = "";
    private string? _taskError;
    private string? _editingTaskId;
    private string _editTitle = "";
    private string _editDescription = "";

    private RepositoryInfo? PanelRepository
    {
        get
        {
            if (_taskRepoPath is not null
                && _repositories.FirstOrDefault(r => string.Equals(r.Path, _taskRepoPath, StringComparison.OrdinalIgnoreCase)) is { } chosen)
            {
                return chosen;
            }

            var preferred = Chat.CurrentRepository ?? Chat.SelectedRepository;
            return (preferred is null ? null : _repositories.FirstOrDefault(r => string.Equals(r.Path, preferred.Path, StringComparison.OrdinalIgnoreCase)))
                ?? _repositories.FirstOrDefault();
        }
    }

    private void OnTaskRepositoryChanged(ChangeEventArgs e)
    {
        _taskRepoPath = e.Value?.ToString();
        _taskError = null;
        _editingTaskId = null;
    }

    private async Task AddTaskAsync()
    {
        _taskError = null;
        var repository = PanelRepository;
        if (repository is null)
        {
            _taskError = "Select a repository first.";
            return;
        }

        try
        {
            await Tasks.CreateAsync(repository, _taskTitle, _taskDescription);
            _taskTitle = "";
            _taskDescription = "";
        }
        catch (Exception ex)
        {
            _taskError = $"Failed to add the task: {ex.Message}";
        }
    }

    private void StartEditTask(RepositoryTask task)
    {
        _taskError = null;
        _editingTaskId = task.Id;
        _editTitle = task.Title;
        _editDescription = task.Description ?? "";
    }

    private void CancelEditTask() => _editingTaskId = null;

    private async Task SaveTaskAsync(RepositoryTask task)
    {
        _taskError = null;
        try
        {
            if (!await Tasks.UpdateAsync(task.Id, _editTitle, _editDescription))
            {
                _taskError = "The task no longer exists or was already sent.";
            }

            _editingTaskId = null;
        }
        catch (Exception ex)
        {
            _taskError = $"Failed to save the task: {ex.Message}";
        }
    }

    private async Task DeleteTaskAsync(RepositoryTask task)
    {
        _taskError = null;
        try
        {
            await Tasks.DeleteAsync(task.Id);
            if (_editingTaskId == task.Id)
            {
                _editingTaskId = null;
            }
        }
        catch (Exception ex)
        {
            _taskError = $"Failed to delete the task: {ex.Message}";
        }
    }

    private async Task SendTaskAsync(RepositoryTask task)
    {
        _taskError = null;
        if (Chat.IsBusy || Chat.IsLoading || Chat.IsMerging)
        {
            return;
        }

        // Validate everything before touching the open conversation or drafts.
        var current = Tasks.Get(task.Id);
        if (current is null || current.IsSent)
        {
            _taskError = "The task no longer exists or was already sent.";
            return;
        }

        var repository = Repositories.GetRepositories()
            .FirstOrDefault(r => string.Equals(r.Path, current.RepositoryPath, StringComparison.OrdinalIgnoreCase));
        if (repository is null)
        {
            _taskError = $"Repository '{task.RepositoryName}' was not found.";
            return;
        }

        ResetDiff();
        _draft = "";
        _answer = "";
        await Chat.ResetAsync();
        RefreshRepositories();

        Chat.SelectRepository(repository);
        var delivered = await Chat.SendAsync(current.ToPrompt());

        if (delivered && Chat.CurrentSessionId is { } sessionId)
        {
            try
            {
                if (!await Tasks.MarkSentAsync(current.Id, sessionId))
                {
                    _taskError = "The task was sent but could no longer be marked as sent (it was deleted or already sent).";
                }
            }
            catch (Exception ex)
            {
                _taskError = $"The task was sent but could not be marked as sent: {ex.Message}";
            }
        }
    }

    private Task OpenTaskConversationAsync(RepositoryTask task) =>
        OpenConversationByIdAsync(task.SessionId, "The conversation of this task was not found.");

    private Task OpenSourceConversationAsync(RepositoryTask task) =>
        OpenConversationByIdAsync(task.SourceSessionId, "The conversation that requested this task no longer exists.");

    private async Task OpenConversationByIdAsync(string? sessionId, string notFoundMessage)
    {
        _taskError = null;
        var summary = _conversations.FirstOrDefault(c => c.Session.SessionId == sessionId);
        if (summary is null)
        {
            try
            {
                await RefreshConversationsAsync();
            }
            catch (Exception ex)
            {
                _taskError = $"Failed to list conversations: {ex.Message}";
                return;
            }

            summary = _conversations.FirstOrDefault(c => c.Session.SessionId == sessionId);
        }

        if (summary is null)
        {
            _taskError = notFoundMessage;
            return;
        }

        await OpenAsync(summary);
    }

    private void AskMerge()
    {
        _mergeError = null;
        _mergeConfirm = true;
    }

    private void CancelMerge() => _mergeConfirm = false;

    private async Task ConfirmMergeAsync()
    {
        _mergeConfirm = false;
        _mergeError = null;
        ConversationMergeResult? result;
        try
        {
            result = await Chat.MergeCurrentAsync(_disposed.Token);
        }
        catch (OperationCanceledException) when (_isDisposed)
        {
            return;
        }

        if (_isDisposed)
        {
            return;
        }

        if (result is not null)
        {
            if (result.Status is ConversationMergeStatus.Merged or ConversationMergeStatus.CleanupFailed)
            {
                ResetDiff();
            }
            else
            {
                _mergeError = result.Message;
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private void ResetDiff()
    {
        _diffVersion++;
        _mergeConfirm = false;
        _mergeError = null;
        _diffOpen = false;
        _diffLoading = false;
        _diff = null;
        _diffError = null;
        _diffSessionId = null;
    }

    private void CloseDiff() => ResetDiff();

    private async Task OpenDiffAsync()
    {
        _diffOpen = true;
        _diffSessionId = Chat.CurrentSessionId;
        await LoadDiffAsync();
    }

    private Task RefreshDiffAsync() => LoadDiffAsync();

    private async Task LoadDiffAsync()
    {
        var version = ++_diffVersion;
        _diffLoading = true;
        _diffError = null;
        _diff = null;
        StateHasChanged();

        ConversationDiff? result = null;
        string? error = null;
        try
        {
            result = await Chat.GetCurrentDiffAsync(_disposed.Token);
            if (result is null)
            {
                error = "No branch was found for this conversation.";
            }
        }
        catch (OperationCanceledException) when (_isDisposed)
        {
            return;
        }
        catch (Exception ex)
        {
            error = $"Failed to load the diff: {ex.Message}";
        }

        if (_isDisposed || version != _diffVersion)
        {
            return;
        }

        _diff = result;
        _diffError = error;
        _diffLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private static string ShortSha(string sha) => sha.Length > 8 ? sha[..8] : sha;

    private static string DisplayPath(DiffFile file) => file.OldPath is null ? file.Path : $"{file.OldPath} → {file.Path}";

    private static string LineClass(DiffLineKind kind) => kind switch
    {
        DiffLineKind.Hunk => "hunk",
        DiffLineKind.Added => "added",
        DiffLineKind.Removed => "removed",
        DiffLineKind.Meta => "meta",
        _ => "context",
    };

    private static string LineMarker(DiffLineKind kind) => kind switch
    {
        DiffLineKind.Added => "+",
        DiffLineKind.Removed => "-",
        DiffLineKind.Context => " ",
        _ => "",
    };

    protected override void OnInitialized()
    {
        try
        {
            _agents = Catalog.LoadAgents();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }

        Chat.Changed += OnChatChanged;
        Ledger.Changed += OnLedgerChanged;
        Tasks.Changed += OnLedgerChanged;
        _listedSessionId = Chat.CurrentSessionId;
        _wasBusy = Chat.IsBusy;
        RefreshRepositories();
        _ = RefreshConversationsAsync();
    }

    /// <summary>Re-runs repository discovery and keeps the selection valid (auto-selects the only repository).</summary>
    private void RefreshRepositories()
    {
        _repositories = Repositories.GetRepositories();
        if (Chat.CurrentSessionId is not null)
        {
            return;
        }

        var selected = Chat.SelectedRepository;
        var match = selected is null ? null : _repositories.FirstOrDefault(r => string.Equals(r.Path, selected.Path, StringComparison.OrdinalIgnoreCase));
        if (match is null && _repositories.Count == 1)
        {
            match = _repositories[0];
        }

        if (!Equals(match, selected))
        {
            Chat.SelectRepository(match);
        }
    }

    private void OnRepositoryChanged(ChangeEventArgs e)
    {
        var path = e.Value?.ToString();
        Chat.SelectRepository(_repositories.FirstOrDefault(r => r.Path == path));
    }

    private async Task RefreshConversationsAsync()
    {
        if (_isDisposed)
        {
            return;
        }

        var version = ++_refreshVersion;
        try
        {
            var list = await Chat.ListConversationsAsync(_disposed.Token);
            if (_isDisposed || version != _refreshVersion)
            {
                return;
            }

            _conversations = list;
            _listError = null;
        }
        catch (OperationCanceledException) when (_isDisposed)
        {
            return;
        }
        catch (Exception ex)
        {
            if (_isDisposed || version != _refreshVersion)
            {
                return;
            }

            _listError = $"Failed to list conversations: {ex.Message}";
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenAsync(ConversationSummary conversation)
    {
        ResetDiff();
        _draft = "";
        _answer = "";
        await Chat.LoadConversationAsync(conversation);
    }

    private async Task SendAsync()
    {
        var prompt = _draft;
        _draft = "";
        await Chat.SendAsync(prompt);
    }

    private async Task AnswerAsync()
    {
        var answer = _answer;
        _answer = "";
        await Chat.AnswerAsync(answer, wasFreeform: true);
    }

    private async Task ResetAsync()
    {
        ResetDiff();
        _draft = "";
        _answer = "";
        await Chat.ResetAsync();
        RefreshRepositories();
    }

    private bool IsOrchestrator(AgentDefinition agent) =>
        string.Equals(agent.Name, Settings.Value.OrchestratorAgent, StringComparison.OrdinalIgnoreCase);

    private static string StatusClass(ChatEntry entry) => entry.Succeeded switch
    {
        true => "ok",
        false => "failed",
        null => "running",
    };

    private static string StatusText(ChatEntry entry) => entry.Succeeded switch
    {
        true => "done",
        false => "failed",
        null => "running",
    };

    private Task OnChatChanged()
    {
        if (_isDisposed)
        {
            return Task.CompletedTask;
        }

        // Re-list when a conversation was created/opened or a run finished.
        if (_diffOpen && !Chat.IsMerging && Chat.CurrentSessionId != _diffSessionId)
        {
            ResetDiff();
        }
        if (_diffOpen && !_wasBusy && Chat.IsBusy)
        {
            // A run started: the diff would be stale and hides the progress.
            ResetDiff();
        }
        var refresh = Chat.CurrentSessionId != _listedSessionId || (_wasBusy && !Chat.IsBusy);
        _listedSessionId = Chat.CurrentSessionId;
        _wasBusy = Chat.IsBusy;
        if (refresh)
        {
            _ = RefreshConversationsAsync();
        }

        return InvokeAsync(StateHasChanged);
    }

    private static string FormatPremium(double value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static string FormatCredits(double value) => value.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);

    private void OnLedgerChanged()
    {
        if (_isDisposed)
        {
            return;
        }

        try
        {
            _ = InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
        }
    }

    public void Dispose()
    {
        _isDisposed = true;
        Chat.Changed -= OnChatChanged;
        Ledger.Changed -= OnLedgerChanged;
        Tasks.Changed -= OnLedgerChanged;
        _disposed.Cancel();
        _disposed.Dispose();
    }
}
