<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>326c01c2-cbe7-40e8-9a8e-40c6e05f4ff9</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Neph.GenericLibs.Net.DiscordLib" Version="0.1.1" />
    <PackageReference Include="Neph.GenericLibs.Net.JwtLib" Version="0.1.6" />
    <PackageReference Include="Neph.GenericLibs.Net.PostgresLib" Version="0.1.2" />
    <PackageReference Include="Octokit" Version="14.0.0" />
  </ItemGroup>

</Project>
